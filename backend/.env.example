SECRET_KEY=change-this-to-a-random-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# PostgreSQL is the default database for this project (matches the project proposal).
# Set USE_POSTGRES=False to fall back to SQLite for quick local testing instead.
USE_POSTGRES=True
DB_NAME=marketplace_db
DB_USER=marketplace_user
DB_PASSWORD=marketplace_pass
DB_HOST=localhost
DB_PORT=5432
# Optional for a single DEBUG server; required with DEBUG=False or multiple workers.
REDIS_URL=
